# ==============================================
# COPY FILE NÀY THÀNH .env
# cp .env.example .env
# ==============================================

# ==============================================
# POSTGRESQL (Medusa database)
# ==============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=medusa_db
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/medusa_db

# ==============================================
# REDIS (Medusa cache & queue)
# ==============================================
REDIS_URL=redis://redis:6379

# ==============================================
# MEDUSA
# ==============================================
MEDUSA_ADMIN_EMAIL=admin@example.com
MEDUSA_ADMIN_PASSWORD=supersecret
JWT_SECRET=your-jwt-secret-here
COOKIE_SECRET=your-cookie-secret-here

# ==============================================
# KAFKA
# ==============================================
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_CLICKSTREAM=clickstream
KAFKA_TOPIC_ORDERS=commerce.orders
KAFKA_TOPIC_CUSTOMERS=commerce.customers
KAFKA_TOPIC_PRODUCTS=commerce.products

# ==============================================
# MINIO (Data Lake - S3 compatible)
# ==============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver
MINIO_BUCKET_GOLD=gold

# AWS credentials format (for Spark S3A connector)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_ENDPOINT_URL=http://minio:9000

# ==============================================
# ELASTICSEARCH
# ==============================================
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme

# ==============================================
# NEXT.JS STOREFRONT
# ==============================================
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ==============================================
# AWS (chỉ dùng khi deploy lên cloud - Tuần 3)
# ==============================================
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=your-s3-bucket
# AWS_MSK_BOOTSTRAP_SERVERS=your-msk-endpoint
# AWS_OPENSEARCH_ENDPOINT=your-opensearch-endpoint
